# ==============================================================================
# Global Git Ignore Rules
# ==============================================================================

# Python bytecode, compilation, and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
.venv311/
env/
venv/
ENV/

# Environment Variables & Secrets (NEVER commit real .env files)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Databases & Runtime SQLite Storage
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
backend/data/
data/*.db
data/*.sqlite*

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/test-results/
dist/
build/

# Application Logs & Ephemeral Runtime Files
*.log
backend.log
frontend.log
eval_60_dataset/
scratch/

cloudflared.log
tunnel.log
debug.log

# Ephemeral Upload & Download Directories
backend/data/storage/
backend/data/downloads/
data/storage/
downloads/
tools/
scratch/
evidence/
docs/unsorted/scratch/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Compiled Binaries
*.exe
*.dll
*.so
*.dylib
cloudflared.exe
.neon
