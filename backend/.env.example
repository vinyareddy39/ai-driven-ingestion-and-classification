# ==============================================================================
# ECM Document Ingestion & Classification Pipeline - Backend Environment Template
# ==============================================================================
# Copy this file to .env and configure values for your deployment.
# NEVER commit real credentials, production secrets, or private keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Environment
# ------------------------------------------------------------------------------
# Deployment environment: 'local' | 'production'
# In production, strict security validations are enforced (Pydantic AppSettings).
APP_ENV=local
ENVIRONMENT=local

# Web server port (Render / Cloud deployment passes PORT automatically)
PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated list of trusted browser frontend URLs)
# In production, wildcards ('*') are strictly rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-file upload limit in megabytes (default 200, maximum 500)
MAX_UPLOAD_MB=200


# ------------------------------------------------------------------------------
# 2. Database & Migrations
# ------------------------------------------------------------------------------
# Database connection URL (PostgreSQL in production, SQLite in local development)
# Local: sqlite:///./data/ecm_pipeline.db
# Production (Render / Neon / RDS): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/ecm_pipeline.db


# ------------------------------------------------------------------------------
# 3. Authentication & Column-Level Data Encryption
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 JWT tokens
# REQUIRED in production: cryptographically random secret with at least 32 characters.
JWT_SECRET=
SECRET_KEY=

# JWT token expiration windows
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Secret key for column-level health and document data encryption at rest (Fernet AES-128-CBC + HMAC)
# REQUIRED in production with no default: 32-byte url-safe base64 string.
DATA_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# Staff authentication headers & role bypass (MUST be false in production)
AUTH_ALLOW_ROLE_HEADER=false
ENABLE_DEMO_TOKENS=false
AUTH_TOKENS=


# ------------------------------------------------------------------------------
# 4. Storage & Processing Lifecycle
# ------------------------------------------------------------------------------
# Storage backend: 'local' (development) | 's3' (production ephemeral containers)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# Ephemeral storage cleanup: delete uploaded files from disk after DB commit
DELETE_UPLOAD_AFTER_PROCESSING=true
DOWNLOAD_EXPIRY_HOURS=24
ALLOW_LOCAL_EXPORT=true

# Optional S3 / Object Storage (Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1


# ------------------------------------------------------------------------------
# 5. OCR & Preprocessing Engine
# ------------------------------------------------------------------------------
# OCR backend: 'hybrid' (PyMuPDF fast lane + OpenCV deskew) | 'tesseract' | 'trocr'
OCR_ENGINE=hybrid
OCR_BATCH_SIZE=8
OCR_USE_GPU=false
OCR_DPI=200
OCR_CACHE_ENABLED=false
OCR_MODEL=microsoft/trocr-base-printed

# Optional paths if Tesseract is outside standard system PATH
TESSERACT_CMD=
TESSDATA_PREFIX=

# Configuration directory and pipeline YAML path
CONFIG_DIR=./config
CONFIG_PATH=./config/pipeline_config.yaml


# ------------------------------------------------------------------------------
# 6. External AI Services & Third-Party LLM Gate
# ------------------------------------------------------------------------------
# Strict opt-in gate: MUST be false by default.
# When false, outbound external LLM/Vision calls (Gemini, Groq, Anthropic, OpenRouter) are disabled.
ENABLE_EXTERNAL_AI=false

# Google Gemini API (active only when ENABLE_EXTERNAL_AI=true)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RPM=15.0
GEMINI_CONCURRENCY=2
GEMINI_ALLOW_SENSITIVE=false

# Groq Cloud API (active only when ENABLE_EXTERNAL_AI=true)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM=30.0
GROQ_CONCURRENCY=3
GROQ_ALLOW_SENSITIVE=false

# Anthropic Claude API (optional fallback when ENABLE_EXTERNAL_AI=true)
ANTHROPIC_API_KEY=

# OpenRouter API (optional fallback when ENABLE_EXTERNAL_AI=true)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free


# ------------------------------------------------------------------------------
# 7. Local LLM Integration (Ollama)
# ------------------------------------------------------------------------------
USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_RPM=120.0
OLLAMA_CONCURRENCY=4


# ------------------------------------------------------------------------------
# 8. Queue, Search & Virus Scanner (Docker / Microservices Architecture)
# ------------------------------------------------------------------------------
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

SEARCH_BACKEND=memory
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=ecm_documents

VIRUS_SCANNER_BACKEND=mock


# ------------------------------------------------------------------------------
# 9. Outbound Webhooks & SMTP Notifications
# ------------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
OUTBOUND_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@ecm.local
