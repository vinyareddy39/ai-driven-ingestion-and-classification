# ==============================================================================
# Document Reader Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials, secrets, or API keys to version control.
# ==============================================================================

# Application Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection
# In production (e.g. Render): postgresql://user:password@host:port/dbname
# In local development: sqlite:///./data/ecm_pipeline.db
DATABASE_URL=sqlite:///./data/ecm_pipeline.db

# Authentication & Security
# Secret key used for signing HS256 JWT tokens (generate a random 32+ char key)
JWT_SECRET=your_random_32_character_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Allowed CORS Browser Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Column-Level Data Encryption Key (32-byte base64 string)
DATA_ENCRYPTION_KEY=c2VjdXJlX2RldmVsb3BtZW50X2tleV9mb3JfcHJpdmFjeV8xMjM=

# OCR & Layout Pipeline Settings
# Recommended for free-tier / 512MB RAM: hybrid (PyMuPDF + OpenCV)
# For GPU instances: trocr
OCR_ENGINE=hybrid
OCR_BATCH_SIZE=8
OCR_USE_GPU=false
OCR_MODEL=microsoft/trocr-base-printed
OCR_DPI=200
OCR_CACHE_ENABLED=true

# Configuration Directory & Paths
CONFIG_DIR=./config
CONFIG_PATH=./config/pipeline_config.yaml

# Ephemeral Storage Management
# When true, uploaded files are purged from disk after DB commit (for ephemeral containers)
DELETE_UPLOAD_AFTER_PROCESSING=true
DOWNLOAD_EXPIRY_HOURS=24

# Optional: Object Storage (Cloudflare R2 / AWS S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Optional: External LLM & Vision Providers (for damaged/unreadable fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
