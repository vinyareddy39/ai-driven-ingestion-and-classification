# ===========================================================================
# ECM Document Ingestion & Classification Pipeline - Environment Configuration
# ===========================================================================
# Copy this file to .env and supply genuine secrets for your deployment.
# NEVER commit real API keys, credentials, or production tokens to source control.

# ---------------------------------------------------------------------------
# 1. Environment & Server
# ---------------------------------------------------------------------------
APP_ENV=local                             # local | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
PORT=8000                                # Port for backend server

# ---------------------------------------------------------------------------
# 2. Database Connection
# ---------------------------------------------------------------------------
# Local: sqlite:///./data/ecm_pipeline.db
# Production: postgresql+psycopg2://user:password@hostname:5432/ecm_db
DATABASE_URL=sqlite:///./data/ecm_pipeline.db

# ---------------------------------------------------------------------------
# 3. Security, Authentication & Encryption Secrets
# ---------------------------------------------------------------------------
# Cryptographically random JWT signing key (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_987654321
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Static staff bearer token mappings formatted as: token:role,token:role
AUTH_TOKENS=secret-token-12345:reviewer,admin-token-67890:admin,compliance-token-99999:compliance

# Security flag: allow X-User-Role header bypass (MUST be false in production)
AUTH_ALLOW_ROLE_HEADER=false

# Allowed browser CORS origins (comma-separated, NO wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fernet 32-byte urlsafe base64 key for column-level encryption of health text
DATA_ENCRYPTION_KEY=c2VjdXJlX2RldmVsb3BtZW50X2tleV9mb3JfcHJpdmFjeV8xMjM=

# Secret for signing outbound JSON webhook payloads using HMAC-SHA256
WEBHOOK_SIGNING_SECRET=default_webhook_hmac_signing_secret_123

# ---------------------------------------------------------------------------
# 4. OCR Engine & Hardware Acceleration Configuration
# ---------------------------------------------------------------------------
OCR_ENGINE=trocr                          # trocr (GPU-accelerated) | tesseract | hybrid
OCR_BATCH_SIZE=16                         # Batch size for line recognition
OCR_USE_GPU=true                          # Utilize NVIDIA CUDA acceleration
OCR_MODEL=microsoft/trocr-base-printed    # trocr-base-printed | trocr-small-printed
OCR_DPI=200                               # Page rendering DPI (200 recommended for speed)
OCR_CACHE_ENABLED=true                    # Cache OCR results by file sha256 hash

# ---------------------------------------------------------------------------
# 5. Object Storage (Local Filesystem or S3 / MinIO / Cloudflare R2 / Backblaze)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local                     # local | s3
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=                          # e.g. https://<account_id>.r2.cloudflarestorage.com or http://localhost:9000
S3_BUCKET=ecm-raw-assets
S3_ACCESS_KEY=                            # Your S3 Access Key ID
S3_SECRET_KEY=                            # Your S3 Secret Access Key
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# 5. AI Services, LLMs & Data Residency Controls
# ---------------------------------------------------------------------------
# Local LLM endpoint (Ollama / vLLM / LocalAI) for residency-restricted classes (Medical, KYC, PII)
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_MODEL=qwen2.5:7b-instruct

# Optional Hosted LLM for non-sensitive, low-risk classes ONLY
LLM_HOSTED_PROVIDER=                      # openai | anthropic | gemini
LLM_HOSTED_API_KEY=                       # Your API key
LLM_HOSTED_MODEL=                         # e.g. gpt-4o-mini or claude-3-5-haiku
LLM_ALLOW_HOSTED_CLASSES=receipt,invoice,unknown

# ---------------------------------------------------------------------------
# 6. Notifications & SMTP Settings (Medication Reminders)
# ---------------------------------------------------------------------------
SMTP_HOST=                                # e.g. smtp.sendgrid.net or mailhog
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@ecm.local

# ---------------------------------------------------------------------------
# 7. Upload and Operational Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
