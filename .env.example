# ECM Ingest Pipeline Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage (MinIO / S3)
STORAGE_BACKEND=local # Options: local, minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecm-raw-assets
MINIO_SECURE=false

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./data/ecm_pipeline.db
# DATABASE_URL=postgresql://ecm_user:ecm_password@localhost:5432/ecm_db

# Queue (Redis Streams / In-Memory fallback)
QUEUE_BACKEND=memory # Options: memory, redis
REDIS_URL=redis://localhost:6379/0

# Search Index (OpenSearch / In-Memory fallback)
SEARCH_BACKEND=memory # Options: memory, opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=ecm_documents

# Virus Scanner (ClamAV / Mock)
VIRUS_SCANNER_BACKEND=mock # Options: mock, clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ECM Adapter (FakeECM / Nuxeo)
ECM_ADAPTER_BACKEND=fake # Options: fake, nuxeo
NUXEO_REST_URL=http://localhost:8080/nuxeo/site/api/v1
NUXEO_USERNAME=Administrator
NUXEO_PASSWORD=Administrator

# OCR Engine
OCR_ENGINE=tesseract # Options: tesseract, fitz

# Paths
CONFIG_PATH=./config/pipeline_config.yaml
SCANNER_WATCH_DIR=./data/scanner_watch
MODEL_ARTIFACTS_DIR=./data/models

# Authentication & Role Security
# Comma-separated token:role pairs with cryptographically random 32+ character secrets (generated with secrets.token_urlsafe(32))
AUTH_TOKENS=<random_32char_reviewer_token>:reviewer,<random_32char_admin_token>:admin,<random_32char_compliance_token>:compliance,<random_32char_viewer_token>:viewer
AUTH_ALLOW_ROLE_HEADER=false
