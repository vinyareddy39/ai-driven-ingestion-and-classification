# Document Reader Configuration

# Anthropic Claude API Key for Vision Extraction
ANTHROPIC_API_KEY=

# Model Name (default: claude-sonnet-5-5 or claude-3-5-sonnet-20241022)
MODEL_NAME=claude-sonnet-5-5

# Secret key for JWT session tokens
JWT_SECRET=super-secret-docsort-key-change-in-prod-xyz789

# SQLite Database URL
DATABASE_URL=sqlite:///./data/ecm_pipeline.db

# Storage Directory for uploaded files
STORAGE_DIR=./data/storage
