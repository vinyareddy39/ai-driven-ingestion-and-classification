# ==============================================================================
# ECM Document Ingestion Frontend - Environment Template
# ==============================================================================
# Verified frontend environment variables.
# Vite variables MUST be prefixed with VITE_ to be exposed to the browser.
# DO NOT include private credentials, secret keys, or database URLs here.
# ==============================================================================

# Backend API Origin
# In local development: leave empty so the Vite dev server proxies API calls to http://127.0.0.1:8000
# In production (e.g. Vercel / Netlify): set to your deployed backend origin (e.g. https://your-backend.onrender.com)
VITE_API_URL=
