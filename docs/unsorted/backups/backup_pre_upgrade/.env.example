# ===========================================================================
# DocSort / AI Document Intake - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and supply genuine secrets for your deployment.
# NEVER commit real credentials, passwords, or tokens to source control.

# ---------------------------------------------------------------------------
# 1. Environment & Server
# ---------------------------------------------------------------------------
ENVIRONMENT=development                  # development | production
APP_ENV=local                            # local | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
PORT=8000                                # Port for backend server

# ---------------------------------------------------------------------------
# 2. Database Connection
# ---------------------------------------------------------------------------
# Local SQLite: sqlite:///./data/ecm_pipeline.db
# Production PostgreSQL: postgresql+psycopg2://user:password@hostname:5432/docsort_db
DATABASE_URL=sqlite:///./data/ecm_pipeline.db

# ---------------------------------------------------------------------------
# 3. Security, Authentication & Session Tokens
# ---------------------------------------------------------------------------
# Cryptographically random JWT signing key (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_here_min_32_chars
JWT_ALGORITHM=HS256

# Token expiration: 8 hours (in minutes: 480)
ACCESS_TOKEN_MINUTES=480

# Staff bearer tokens (token:role pairs) for service-to-service or CLI access
AUTH_TOKENS=

# Role header bypass (MUST be false in all environments)
AUTH_ALLOW_ROLE_HEADER=false

# Allowed browser CORS origins (comma-separated, NO wildcards with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fernet 32-byte urlsafe base64 key for column-level encryption of sensitive text at rest
ENCRYPTION_KEY=your_urlsafe_base64_32_byte_fernet_encryption_key_here

# ---------------------------------------------------------------------------
# 4. Initial Test User Passwords (read by scripts/manage_users.py)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password_here
REVIEWER_PASSWORD=your_secure_reviewer_password_here
UPLOADER_PASSWORD=your_secure_uploader_password_here

# ---------------------------------------------------------------------------
# 5. Storage & OCR Engine Configuration
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local                     # local | s3
STORAGE_LOCAL_DIR=./data/storage
OCR_ENGINE=trocr                          # trocr | tesseract | hybrid
OCR_USE_GPU=true
OCR_DPI=200
OCR_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# 6. Upload Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=200
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
